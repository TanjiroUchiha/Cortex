# Cortex config — copy to .env and fill in. Never commit .env.

# MongoDB Atlas account store (backend/db.py). MONGO_CLUSTER looks like
# cluster0.xxxxx.mongodb.net — the part after '@' in your Atlas connect string.
# The database user needs readWrite on the 'cortex' database only, and your
# IP must be allowlisted under Atlas → Network Access.
MONGO_USERNAME=
MONGO_PASSWORD=
MONGO_CLUSTER=
# MONGO_DB=cortex                       # optional override, defaults to cortex

# JWT signing secret — >=32 chars; required in live mode, ephemeral in demo.
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
CORTEX_JWT_SECRET=

# First-run admin bootstrap — only used while no admin exists. Prefer
# scripts/create_admin.py for adding admins after that.
# CORTEX_ADMIN_EMAIL=
# CORTEX_ADMIN_PASSWORD=
